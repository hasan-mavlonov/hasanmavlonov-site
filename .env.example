# Public origin of the site. Inlined at build time and used for canonical URLs,
# sitemap.xml, llms.txt and Open Graph image URLs. Falls back to
# https://hasanmavlonov.com when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: analytics ---------------------------------------------------
# OpenPanel client id for the browser tracker. Without it, page views and the
# trackEvent() calls are no-ops.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
# Google Tag Manager container id. Omit to skip loading GTM.
NEXT_PUBLIC_GTM_ID=

# Server-side OpenPanel credentials for the /insights page. Without all three,
# the page renders its empty state instead of visitor metrics.
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=

# --- Optional: other ------------------------------------------------------
# Personal access token used to read GitHub star counts (public, read-only
# scope is enough). Unset means the count is hidden.
GITHUB_API_TOKEN=
# Discord webhook that receives blog post feedback submissions. Unset disables
# the feedback form's delivery.
DISCORD_FEEDBACK_WEBHOOK_URL=
# Link used by the DMCA badge in the footer.
NEXT_PUBLIC_DMCA_URL=
