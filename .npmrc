# fumadocs-core declares an optional peer on zod 4, while this app pins zod 3
# for its own schemas (src/lib/events.ts). The zod-dependent fumadocs features
# are unused here - only remark-heading and the table-of-contents helpers are -
# so npm's strict peer resolution is relaxed to keep a single zod 3 install.
legacy-peer-deps=true
